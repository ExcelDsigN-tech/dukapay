# Production environment template for mainnet launch
# See docs/ENVIRONMENT.md#production-mainnet-posture for rationale and review dates.
# Copy to backend/.env.production and fill secrets via your secrets manager (never commit the filled file).
# This file is explicitly checked by scripts/verify-production-env.mjs and the deploy-production guard.

CORS_ALLOWED_ORIGINS=https://dukapay.com,https://app.dukapay.com
FRONTEND_URL=https://app.dukapay.com
PORT=3001
DATABASE_URL=postgres://user:pass@prod-db:5432/dukapay
REDIS_URL=redis://prod-redis:6379

# Stellar — MAINNET (reviewed 2026-03-15 for Public Global Stellar Network)
STELLAR_NETWORK=mainnet
STELLAR_RPC_URL=https://soroban-rpc.stellar.org
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
LOAN_MANAGER_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADUMMY
REMITTANCE_NFT_CONTRACT_ID=CBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBDUMMY
LENDING_POOL_CONTRACT_ID=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCDUMMY
MULTISIG_GOVERNANCE_CONTRACT_ID=CDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDUMMY
AGENT_REGISTRY_CONTRACT_ID=CEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEDUMMY
AGENT_VAULT_CONTRACT_ID=CFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFDUMMY
POOL_TOKEN_ADDRESS=CGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGDUMMY
STELLAR_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# Set per actual mainnet issuers (Circle USDC, etc.) — reviewed for target jurisdiction
STELLAR_EURC_ISSUER=
STELLAR_PHP_ISSUER=

# ── KYC/AML — MUST be enabled for mainnet (per #565 decision, enforced by deploy guard) ──
# Decision (2026-03-15, compliance+product): mainnet launches with KYC enforcement ON and audit anchoring ON.
# Staging may remain false for test accounts; production must be true or deploy fails.
KYC_ENFORCEMENT_ENABLED=true
COMPLYADVANTAGE_API_KEY=__SET_VIA_SECRETS_MANAGER__
COMPLYADVANTAGE_API_URL=https://api.complyadvantage.com
COMPLYADVANTAGE_SEARCH_PROFILE=dukapay_production_ofac_pep_adverse
# Reviewed 2026-03-15 for Kenya (CBK), Nigeria (CBN), Ghana (BoG):
# - Threshold KES 1,300,000 / NGN 15,000,000 / GHS 150,000 ≈ USD 10,000 equivalent (FATF R.10, CBK PG/AML 2023)
# - Daily velocity limit 10 aligns with agent float turnover analysis (max 8/day p95, 10 flags abuse)
AML_REPORTING_THRESHOLD=10000
AML_DAILY_TX_LIMIT=10
# FATF grey/black list + EU high-risk third countries, reviewed 2025-06 for KE/NG/GH launch.
# Source: FATF Public Statement (Feb 2025), EU Delegated Regulation 2024/254. Maintain via compliance review quarterly.
AML_HIGH_RISK_COUNTRIES=AF,BY,CF,CD,CU,ER,GN,HT,IR,KP,LB,LY,MM,NI,RU,SO,SS,SD,SY,UA,VE,YE,ZW
SAR_FILING_API_URL=https://compliance.dukapay.internal/api/sar
SAR_FILING_API_TOKEN=__SET_VIA_SECRETS_MANAGER__

# ── Audit anchoring — MUST be enabled for mainnet ──
AUDIT_ANCHOR_ENABLED=true
AUDIT_ANCHOR_CONTRACT_ID=CHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHDUMMY
AUDIT_ANCHOR_SOURCE_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADUMMY
INDEXER_FINALITY_DEPTH=10
INDEXER_LAG_ALERT_THRESHOLD=50

# Loan / pool config (reviewed for mainnet risk — keep conservative vs staging)
LOAN_MIN_SCORE=600
LOAN_MAX_AMOUNT=25000
LOAN_INTEREST_RATE_PERCENT=10
CREDIT_SCORE_THRESHOLD=650

# Security — never use defaults in production
JWT_SECRET=__SET_VIA_SECRETS_MANAGER_32B_MIN__
INTERNAL_API_KEY=__SET_VIA_SECRETS_MANAGER__
ADMIN_WALLETS=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAGRO,GBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
AGENT_WALLETS=
AUDITOR_WALLETS=
LENDER_WALLETS=
EXPOSE_STACK_TRACES=false
JWT_COOKIE_NAME=dukapay_jwt
SENTRY_DSN=https://sentry.io/production-dsn
NOTIFICATION_RETENTION_DAYS=90
READ_NOTIFICATION_RETENTION_DAYS=30
SENDGRID_API_KEY=__SET_VIA_SECRETS_MANAGER__
FROM_EMAIL=noreply@dukapay.com
ADMIN_EMAIL=compliance@dukapay.com
ADMIN_WEBHOOK_URL=https://hooks.dukapay.internal/admin
TWILIO_ACCOUNT_SID=__SET_VIA_SECRETS_MANAGER__
TWILIO_AUTH_TOKEN=__SET_VIA_SECRETS_MANAGER__
TWILIO_PHONE_NUMBER=+15551234567
