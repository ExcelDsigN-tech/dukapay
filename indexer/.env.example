# DukaPay standalone Rust indexer — see README.md for the full table.
INDEXER_RPC_URL=https://soroban-testnet.stellar.org
INDEXER_CONTRACT_IDS=
INDEXER_FINALITY_DEPTH=5
INDEXER_POLL_INTERVAL_MS=3000
INDEXER_BATCH_SIZE=200
INDEXER_WORKER_CONCURRENCY=8
INDEXER_CHANNEL_CAPACITY=10000

# Horizontal scaling (one replica per shard)
INDEXER_SHARD_INDEX=0
INDEXER_SHARD_TOTAL=1

# Checkpoints: set a Postgres DSN for multi-replica, otherwise a local file is used
INDEXER_CHECKPOINT_DSN=
INDEXER_CHECKPOINT_FILE=./checkpoints.json

# Sink: stdout | file | kafka
INDEXER_SINK=stdout
INDEXER_SINK_FILE=./events.ndjson
INDEXER_KAFKA_BROKERS=
INDEXER_KAFKA_TOPIC=dukapay.contract-events

INDEXER_METRICS_PORT=9464
INDEXER_LAG_ALERT_THRESHOLD=100
INDEXER_LOG=info
INDEXER_LOG_FORMAT=json
