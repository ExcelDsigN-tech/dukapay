# Load Testing Environment Configuration
# Copy this file to .env and fill in the values

# Test Environment (staging, production)
TEST_ENV=staging

# Load Profile (smoke, normal, stress, spike)
LOAD_PROFILE=normal

# Test Duration (short, medium, long)
TEST_DURATION=medium

# API URLs
STAGING_API_URL=https://api.staging.dukapay.io
STAGING_RPC_URL=https://rpc.staging.dukapay.io
PROD_API_URL=https://api.dukapay.io
PROD_RPC_URL=https://rpc.dukapay.io

# Authentication (use long-lived test tokens)
TEST_AUTH_TOKEN=your-test-token-here
TEST_API_KEY=your-api-key-here

# Alert Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=ops@dukapay.io

# Git Configuration (for baseline versioning)
GIT_SHA=
BUILD_TIME=
